datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             Int            @id @default(autoincrement())
  tenantId       String         @default("default_tenant") @map("tenant_id") @db.VarChar(50)
  username       String         @unique @db.VarChar(50)
  passwordHash   String         @map("password_hash") @db.VarChar(255)
  role           String         @default("trainee")
  supervisorId   Int?           @map("supervisor_id")
  supervisor     User?          @relation("SupervisorTrainees", fields: [supervisorId], references: [id])
  trainees       User[]         @relation("SupervisorTrainees")
  entries        Entry[]
  profile        ReportProfile?
  evidence       WeeklyEvidence[]
  sessions       Session[]
  auditLogs      AuditLog[]
  aiUsageLogs    AiUsageLog[]
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("users")
}

model Session {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String   @map("refresh_token_hash") @db.VarChar(255)
  familyId         String   @map("family_id") @db.VarChar(64)
  deviceInfo       String?  @map("device_info") @db.VarChar(255)
  ipAddress        String?  @map("ip_address") @db.VarChar(50)
  isRevoked        Boolean  @default(false) @map("is_revoked")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model Entry {
  id          Int             @id @default(autoincrement())
  tenantId    String          @default("default_tenant") @map("tenant_id") @db.VarChar(50)
  userId      Int             @map("user_id")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryDate   String          @map("entry_date") @db.VarChar(20)
  timeFrom    String          @map("time_from") @db.VarChar(10)
  timeTo      String          @map("time_to") @db.VarChar(10)
  title       String          @db.VarChar(150)
  category    String          @default("أخرى") @db.VarChar(50)
  description String          @db.Text
  deletedAt   DateTime?       @map("deleted_at")
  revisions   EntryRevision[]
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([userId, entryDate])
  @@index([tenantId])
  @@map("entries")
}

model EntryRevision {
  id          Int      @id @default(autoincrement())
  entryId     Int      @map("entry_id")
  entry       Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  title       String   @db.VarChar(150)
  category    String   @db.VarChar(50)
  description String   @db.Text
  timeFrom    String   @map("time_from") @db.VarChar(10)
  timeTo      String   @map("time_to") @db.VarChar(10)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("entry_revisions")
}

model ReportProfile {
  userId               Int                      @id @map("user_id")
  tenantId             String                   @default("default_tenant") @map("tenant_id") @db.VarChar(50)
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentName          String                   @default("") @map("student_name") @db.VarChar(100)
  trainingNumber       String                   @default("") @map("training_number") @db.VarChar(50)
  department           String                   @default("") @db.VarChar(100)
  trainingUnit         String                   @default("") @map("training_unit") @db.VarChar(150)
  supervisorName       String                   @default("") @map("supervisor_name") @db.VarChar(100)
  responsibleName      String                   @default("") @map("responsible_name") @db.VarChar(100)
  entityAddress        String                   @default("") @map("entity_address") @db.VarChar(200)
  employeesCount       String                   @default("") @map("employees_count") @db.VarChar(50)
  trainingWeeks        Int                      @default(14) @map("training_weeks")
  courseHours          Int                      @default(280) @map("course_hours")
  startDate            String                   @default("") @map("start_date") @db.VarChar(20)
  companyLogo          String?                  @map("company_logo") @db.MediumText
  institutionLogo      String?                  @map("institution_logo") @db.MediumText
  reportTemplate       String                   @default("royal") @map("report_template") @db.VarChar(50)
  executiveSummary     String?                  @map("executive_summary") @db.Text
  challengesText       String?                  @map("challenges_text") @db.Text
  recommendationsText  String?                  @map("recommendations_text") @db.Text
  introText            String?                  @map("intro_text") @db.Text
  entityIntroText      String?                  @map("entity_intro_text") @db.Text
  skillsText           String?                  @map("skills_text") @db.Text
  conclusionText       String?                  @map("conclusion_text") @db.Text
  supervisorNotes      String?                  @map("supervisor_notes") @db.Text
  supervisorRating     String                   @default("") @map("supervisor_rating") @db.VarChar(50)
  supervisorApproved   Boolean                  @default(false) @map("supervisor_approved")
  supervisorApprovedAt DateTime?                @map("supervisor_approved_at")
  status               String                   @default("draft") @db.VarChar(50)
  verificationHash     String?                  @map("verification_hash") @db.VarChar(64)
  statusHistory        ReportStatusHistory[]
  comments             ReportSectionComment[]

  @@index([tenantId])
  @@map("report_profile")
}

model ReportStatusHistory {
  id         Int           @id @default(autoincrement())
  reportId   Int           @map("report_id")
  report     ReportProfile @relation(fields: [reportId], references: [userId], onDelete: Cascade)
  actorId    Int           @map("actor_id")
  fromStatus String        @map("from_status") @db.VarChar(50)
  toStatus   String        @map("to_status") @db.VarChar(50)
  note       String?       @db.Text
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([reportId])
  @@map("report_status_history")
}

model ReportSectionComment {
  id           Int           @id @default(autoincrement())
  reportId     Int           @map("report_id")
  report       ReportProfile @relation(fields: [reportId], references: [userId], onDelete: Cascade)
  supervisorId Int           @map("supervisor_id")
  sectionKey   String        @map("section_key") @db.VarChar(50)
  comment      String        @db.Text
  resolved     Boolean       @default(false)
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([reportId, sectionKey])
  @@map("report_section_comments")
}

model WeeklyEvidence {
  id        Int       @id @default(autoincrement())
  tenantId  String    @default("default_tenant") @map("tenant_id") @db.VarChar(50)
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekIndex Int       @map("week_index")
  caption   String    @db.VarChar(255)
  imageData String    @map("image_data") @db.MediumText
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, weekIndex])
  @@index([tenantId])
  @@map("weekly_evidence")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  tenantId   String   @default("default_tenant") @map("tenant_id") @db.VarChar(50)
  userId     Int?     @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(50)
  metadata   String?  @db.Text
  ipAddress  String?  @map("ip_address") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model AiUsageLog {
  id           Int      @id @default(autoincrement())
  tenantId     String   @default("default_tenant") @map("tenant_id") @db.VarChar(50)
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   @db.VarChar(50)
  action       String   @db.VarChar(50)
  tokensIn     Int      @default(0) @map("tokens_in")
  tokensOut    Int      @default(0) @map("tokens_out")
  costEstimate Float    @default(0) @map("cost_estimate")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([userId])
  @@map("ai_usage_logs")
}
