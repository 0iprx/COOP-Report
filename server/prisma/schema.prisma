datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             Int            @id @default(autoincrement())
  username       String         @unique @db.VarChar(50)
  passwordHash   String         @map("password_hash") @db.VarChar(255)
  role           String         @default("trainee")
  supervisorId   Int?           @map("supervisor_id")
  supervisor     User?          @relation("SupervisorTrainees", fields: [supervisorId], references: [id])
  trainees       User[]         @relation("SupervisorTrainees")
  entries        Entry[]
  profile        ReportProfile?
  evidence       WeeklyEvidence[]
  createdAt      DateTime       @default(now()) @map("created_at")

  @@map("users")
}

model Entry {
  id          Int             @id @default(autoincrement())
  userId      Int             @map("user_id")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryDate   String          @map("entry_date") @db.VarChar(20)
  timeFrom    String          @map("time_from") @db.VarChar(10)
  timeTo      String          @map("time_to") @db.VarChar(10)
  title       String          @db.VarChar(150)
  category    String          @default("أخرى") @db.VarChar(50)
  description String          @db.Text
  deletedAt   DateTime?       @map("deleted_at")
  revisions   EntryRevision[]
  createdAt   DateTime        @default(now()) @map("created_at")

  @@map("entries")
}

model EntryRevision {
  id          Int      @id @default(autoincrement())
  entryId     Int      @map("entry_id")
  entry       Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  title       String   @db.VarChar(150)
  category    String   @db.VarChar(50)
  description String   @db.Text
  timeFrom    String   @map("time_from") @db.VarChar(10)
  timeTo      String   @map("time_to") @db.VarChar(10)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("entry_revisions")
}

model ReportProfile {
  userId          Int      @id @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentName     String   @default("") @map("student_name") @db.VarChar(100)
  trainingNumber  String   @default("") @map("training_number") @db.VarChar(50)
  department      String   @default("") @db.VarChar(100)
  trainingUnit    String   @default("") @map("training_unit") @db.VarChar(150)
  supervisorName  String   @default("") @map("supervisor_name") @db.VarChar(100)
  responsibleName String   @default("") @map("responsible_name") @db.VarChar(100)
  entityAddress   String   @default("") @map("entity_address") @db.VarChar(200)
  employeesCount  String   @default("") @map("employees_count") @db.VarChar(50)
  trainingWeeks   Int      @default(14) @map("training_weeks")
  courseHours     Int      @default(280) @map("course_hours")
  startDate            String    @default("") @map("start_date") @db.VarChar(20)
  companyLogo          String?   @map("company_logo") @db.MediumText
  institutionLogo      String?   @map("institution_logo") @db.MediumText
  reportTemplate       String    @default("royal") @map("report_template") @db.VarChar(50)
  executiveSummary     String?   @map("executive_summary") @db.Text
  challengesText       String?   @map("challenges_text") @db.Text
  recommendationsText  String?   @map("recommendations_text") @db.Text
  introText            String?   @map("intro_text") @db.Text
  entityIntroText      String?   @map("entity_intro_text") @db.Text
  skillsText           String?   @map("skills_text") @db.Text
  conclusionText       String?   @map("conclusion_text") @db.Text
  supervisorNotes      String?   @map("supervisor_notes") @db.Text
  supervisorRating     String    @default("") @map("supervisor_rating") @db.VarChar(50)
  supervisorApproved   Boolean   @default(false) @map("supervisor_approved")
  supervisorApprovedAt DateTime? @map("supervisor_approved_at")

  @@map("report_profile")
}

model WeeklyEvidence {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekIndex Int      @map("week_index")
  caption   String    @db.VarChar(255)
  imageData String    @map("image_data") @db.MediumText
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("weekly_evidence")
}
